{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "mcp__github__*",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git fetch *)", "Bash(git pull *)",
      "Bash(git push -u origin claude/*)", "Bash(git push origin claude/*)",
      "Bash(git checkout *)", "Bash(git switch *)", "Bash(git branch *)", "Bash(git merge *)",
      "Bash(git stash *)", "Bash(git restore *)", "Bash(git mv *)", "Bash(git rm *)",
      "Bash(./gradlew *)", "Bash(chmod +x gradlew)",
      "Bash(python3 tools/validate.py *)", "Bash(python3 tools/pack.py *)", "Bash(python3 tools/logscan.py *)",
      "Bash(unzip *)", "Bash(jar *)", "Bash(javap *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)"
    ],
    "deny": [
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --force-with-lease *)"
    ]
  }
}
